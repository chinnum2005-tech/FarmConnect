# AgriTrace AI - Monorepo Environment Configuration

# ============================================
# DATABASE CONFIGURATION (MongoDB Atlas)
# ============================================
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/farmconnect"

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================
# BACKEND API CONFIGURATION
# ============================================
BACKEND_PORT="3001"
BACKEND_URL="http://localhost:3001"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# ============================================
# WEATHER SERVICE (OpenWeather Proxy)
# ============================================
OPENWEATHER_API_KEY="your-openweather-api-key-here"

# ============================================
# STRIPE PAYMENT GATEWAY CONFIGURATION
# ============================================
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret"

# ============================================
# AI & ML SERVICE CONFIGURATION
# ============================================
AI_SERVICE_PORT="8000"
AI_SERVICE_URL="http://localhost:8000"
ML_SERVICE_URL="http://localhost:8001"
FRONTEND_URL="http://localhost:5173"
AGMARKNET_API_KEY="your-agmarknet-api-key"

# ============================================
# BLOCKCHAIN CONFIGURATION (Polygon Amoy Testnet & Local)
# ============================================
BLOCKCHAIN_NETWORK="local" # "local" for local Hardhat node (chainId 31337), "amoy" for Polygon Amoy testnet (chainId 80002)
# Canonical RPC URL is POLYGON_RPC_URL; RPC_URL is supported as fallback alias
POLYGON_RPC_URL="https://polygon-amoy-bor-rpc.publicnode.com"
RPC_URL="https://polygon-amoy-bor-rpc.publicnode.com"
POLYGON_CHAIN_ID="80002"
AGROTRACE_REGISTRY_ADDRESS="0x0000000000000000000000000000000000000000"
TRACEABILITY_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
PROVENANCE_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Backend Runtime Signer (Polygon Amoy - Mandatory)
# RELAYER_PRIVATE_KEY is strictly required on Amoy (fail-closed if missing, dev keys prohibited).
RELAYER_PRIVATE_KEY="your-relayer-private-key-here" # Canonical signing key holding RELAYER_ROLE
# AMOY_RELAYER_ADDRESS is strictly required on Amoy (canonical). RELAYER_ADDRESS is supported as fallback alias.
# The backend validates that the derived wallet matches this expected address, and performs an on-chain
# read-only authorization preflight (hasRole(RELAYER_ROLE, signerAddress)) before state-changing transactions.
AMOY_RELAYER_ADDRESS="0x0000000000000000000000000000000000000000"
RELAYER_ADDRESS="" # Optional fallback alias for AMOY_RELAYER_ADDRESS

# Deployment & Testnet Tooling (Deployment Only - NOT backend runtime)
AMOY_DEPLOYER_PRIVATE_KEY="your-amoy-deployer-private-key-here" # Deployer key (assigns roles in constructor)
AMOY_ADMIN_ADDRESS="0x0000000000000000000000000000000000000000" # Contract admin/pauser target address
POLYGONSCAN_API_KEY="your-polygonscan-api-key-here"
DEPLOY_CONFIRM="false" # Must explicitly be set to "true" only when live deployment is authorized


# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_BACKEND_URL="http://localhost:3001"
VITE_AI_SERVICE_URL="http://localhost:8000"

# ============================================
# QR CODE CONFIGURATION
# ============================================
QR_CODE_SECRET="qr-code-secret-key"

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="5242880"
